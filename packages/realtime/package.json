{
  "name": "@hushbox/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events.ts",
    "./protocol": "./src/protocol.ts",
    "./user-rooms": "./src/user-rooms.ts"
  },
  "scripts": {
    "test": "tsx ../../scripts/with-env.ts vitest run && pnpm run test:workers",
    "test:workers": "tsx ../../scripts/with-env.ts vitest run --config vitest.workers.config.ts",
    "test:watch": "tsx ../../scripts/with-env.ts vitest",
    "test:coverage": "tsx ../../scripts/with-env.ts vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.15",
    "@cloudflare/workers-types": "^4.20260612.1",
    "@hushbox/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@hushbox/shared": "workspace:*",
    "zod": "^4.4.3"
  }
}
