{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      // The behavioral-spec coverage checker is run manually with node (see
      // its README); nothing imports it, so it is an entry by contract.
      "entry": ["docs/plans/behavioral-spec/coverage-check.mjs"],
    },
    "ads": {
      // Ad production tooling: scripts are run directly with tsx and Remotion
      // compositions load by convention, so nothing imports them — every
      // script and barrel in the package is an entry by contract.
      "entry": ["**/*.{ts,tsx}"],
    },
    "apps/api": {
      // Published slice surfaces awaiting consumers; later slices import them.
      "entry": [
        "src/lib/jobs/index.ts",
        "src/slices/models/index.ts",
        "src/slices/models/domain/index.ts",
        "src/slices/admin/index.ts",
        "src/slices/admin/domain/index.ts",
        // The workerd validation project's config: run by `test:workers`, never
        // imported (the explicit entry list above suppresses knip's default
        // config-file detection for this workspace).
        "vitest.workers.config.ts",
      ],
      "project": ["src/**/*.ts"],
      // The slice template is scaffolding, not code. The telemetry port file is
      // ignored for its deliberate exported contract type (TelemetryErrorChannel).
      "ignore": ["src/slices/_template/**", "src/lib/telemetry/port.ts"],
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@capacitor/ios"],
    },
    "apps/admin": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "apps/crawler-view": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "apps/sandbox": {
      // Assets-only worker: serve.ts/build.ts are entries via the dev/build
      // scripts. wrangler is a deploy-time binary (`wrangler deploy` in CI), not
      // a JS import — the wrangler plugin does not mark it used for an
      // assets-only worker (no `main` entry), so declare it explicitly.
      //
      // The serve/build script entries are auto-detected from package.json
      // scripts. The two bootstrap.ts files are esbuild entry points the build
      // scripts resolve by string path (path.join(dir, 'bootstrap.ts')), so knip
      // cannot trace them from the import graph — declared here by contract.
      "entry": ["src/render/bootstrap.ts", "src/python/bootstrap.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["wrangler"],
    },
    "packages/shared": {
      "project": ["src/**/*.ts"],
    },
    "packages/db": {
      "project": ["src/**/*.ts"],
      // "cloudflare" provides the cloudflare:workers/cloudflare:test builtins
      // (same as packages/realtime). The remaining entries are consumed only by
      // the quarantined /legacy/ corpus (moved out of this package's scanned
      // scope); they stay declared to keep the archive coherent and are removed
      // when the corpus is deleted.
      "ignoreDependencies": [
        "cloudflare",
        "drizzle-zod",
        "ws",
        "zod",
        "@hushbox/crypto",
        "@types/ws",
      ],
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"],
      // No source file imports onnxruntime-common; it is declared to pin the
      // copy the bundlers resolve. @huggingface/transformers' browser build
      // (reached via kokoro-js in the TTS worker) externalizes a bare
      // `onnxruntime-common` import and re-exports its `Tensor` class — the one
      // the engine passes into inference — but transformers' own dependency set
      // does not contain that package, so resolution falls through to whichever
      // copy pnpm hoists, and this declaration is what decides it. The version
      // is exact-pinned (no range) to the one transformers' own
      // onnxruntime-web dependency pins, so the externalized `Tensor` matches
      // the `Tensor` inlined in the onnxruntime runtime that consumes it; a
      // range would silently drift the shipped worker on any install.
      // Unrelated to the self-hosted /ort/ runtime assets, which
      // `ort-assets-plugin.ts` reads out of transformers' own dist.
      "ignoreDependencies": ["onnxruntime-common"],
    },
    "packages/config": {
      // Tooling entry points: topic-named arch rule files and the eslint
      // extension slot (both loaded dynamically — by the arch runner and
      // eslint.config.js respectively — so knip cannot trace them; they are
      // entries by contract). The runner itself is traced from the root
      // arch:check script.
      "entry": ["arch/rules/*.rule.ts", "eslint-extensions/*.config.mjs"],
      "project": ["**/*.{js,mjs,ts}"],
      "ignore": ["import-meta-env.d.ts"],
    },
    "scripts": {
      "entry": ["*.ts", "!*.test.ts", "lib/idle-killer-daemon-entry.ts"],
      "project": ["**/*.ts"],
    },
    "ops": {
      "entry": ["**/*.ts", "!**/*.test.ts"],
      "project": ["**/*.ts"],
    },
    "e2e": {
      "entry": [
        "fixtures.ts",
        "auth.setup.ts",
        "global-setup.ts",
        "global-teardown.ts",
        "**/*.spec.ts",
      ],
      "project": ["**/*.ts"],
    },
    "packages/realtime": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["cloudflare"],
    },
    "apps/marketing": {
      "entry": ["src/pages/**/*.astro"],
      "project": ["src/**/*.{astro,ts,tsx}"],
    },
  },
  // The quarantined /legacy/ corpus sits at the repo root (not a workspace);
  // knip's root workspace would otherwise scan it. It is out of every gate.
  // docs/plans/runs/ holds subagent-driven-dev run records and throwaway
  // spike artifacts — run history, not source to analyze for unused exports.
  "ignore": [".claude/**", "legacy/**", "docs/plans/runs/**"],
  "ignoreDependencies": [
    // ESLint output formatter — invoked via CLI (`lint:summary` = `eslint
    // --format summary`), never imported, so knip can't see the reference.
    "eslint-formatter-summary",
    // Markdown stylesheet loaded by filesystem path in
    // scripts/readme/preview-readme.ts (node_modules/github-markdown-css/...),
    // not a JS import.
    "github-markdown-css",
    // Pulled in via CSS `@import 'tailwindcss'` in
    // packages/config/tailwind/index.css; knip does not follow CSS @import.
    "tailwindcss",
    // Pulled in via CSS `@import 'tw-animate-css'` in the same shared Tailwind
    // entry; knip does not follow CSS @import.
    "tw-animate-css",
    // Root-level version pins for the transitive HTML/CSS parser stack:
    // declared as direct deps to hoist a single patched major for the build/
    // SVG tooling that consumes them, never imported directly here.
    "css-select",
    "css-tree",
    "domutils",
    "htmlparser2",
  ],
  "ignoreBinaries": ["maestro", "adb", "cap", "wrangler", "drizzle-kit", "tar"],
  "ignoreExportsUsedInFile": true,
  "playwright": {
    "config": ["playwright.config.{js,ts,mjs}", "playwright-ct.config.{js,ts,mjs}"],
  },
}
