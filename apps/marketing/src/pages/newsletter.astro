---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import LabeledRule from '../components/LabeledRule.astro';
import { NewsletterSignup } from '../components/newsletter/NewsletterSignup';

const NEWSLETTER_CIPHER_MESSAGES: readonly string[] = [
  'A Few Letters a Year',
  'No Tracking',
  'Written by Humans',
  'Leave Any Time',
  'No Spam, Ever',
  'Signal, Not Noise',
  'Worth Your Inbox',
];
---

<LandingLayout
  title="Letters from HushBox"
  description="An occasional newsletter from HushBox. A few letters a year, no tracking, written by humans."
>
  <LandingHeader />

  <main class="flex-1 pt-20">
    <PageHero messages={NEWSLETTER_CIPHER_MESSAGES}>
      <h1 class="font-serif text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        Letters from HushBox
      </h1>
    </PageHero>

    <section class="mx-auto max-w-xl px-6 pt-8 pb-16">
      <LabeledRule lines={['A few letters a year', 'No tracking']} />
      <NewsletterSignup client:load />
    </section>
  </main>

  <SiteFooter />
</LandingLayout>
