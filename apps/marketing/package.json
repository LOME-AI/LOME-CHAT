    "test:watch": "tsx ../../scripts/with-env.ts vitest"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@hushbox/crypto": "workspace:*",
    "@hushbox/shared": "workspace:*",
    "@hushbox/ui": "workspace:*",
    "astro": "^5.18.2",
    "lucide-react": "^0.577.0",
    "lucide-static": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@hushbox/config": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.11.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.8"
  }
