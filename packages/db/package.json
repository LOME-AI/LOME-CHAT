{
  "name": "@hushbox/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./factories": "./src/factories/index.ts"
  },
  "scripts": {
    "dev": "pnpm db:studio",
    "db:generate": "tsx ../../scripts/with-env.ts tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx ../../scripts/with-env.ts tsx ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "tsx ../../scripts/with-env.ts tsx ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "tsx ../../scripts/with-env.ts tsx ../../scripts/drizzle-studio.ts",
    "test": "tsx ../../scripts/with-env.ts vitest run --coverage && pnpm run test:workers",
    "test:workers": "tsx ../../scripts/with-env.ts vitest run --config vitest.workers.config.ts",
    "test:watch": "tsx ../../scripts/with-env.ts vitest",
    "lint": "eslint .",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@hushbox/shared": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.15",
    "@cloudflare/workers-types": "^4.20260612.1",
    "@faker-js/faker": "^10.4.0",
    "@hushbox/config": "workspace:*",
    "@hushbox/crypto": "workspace:*",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "fishery": "^2.4.0",
    "pg": "^8.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
