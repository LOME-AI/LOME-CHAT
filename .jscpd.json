{
  "$schema": "https://json.schemastore.org/jscpd.json",
  "threshold": 2,
  "minLines": 5,
  "minTokens": 50,
  "reporters": ["console", "json"],
  "output": "./reports/jscpd",
  "gitignore": true,
  "format": ["typescript", "javascript", "tsx", "jsx"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.d.ts",
    "**/__snapshots__/**",
    "**/coverage/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/mocks/**",
    "**/__test-fixtures-*__/**",
    "**/slices/_template/**",
    "**/*.gen.ts",
    "**/.wrangler/**",
    "**/ios/App/App/public/**",
    "**/android/app/src/main/assets/public/**",
    "legacy/**"
  ]
}
