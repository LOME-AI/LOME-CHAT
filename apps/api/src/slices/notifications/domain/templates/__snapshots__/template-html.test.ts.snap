            <td align="center" style="padding: 20px 0; border-bottom: 1px solid #27272a;">
              <span style="font-size: 24px; font-weight: 700; color: #fafafa; letter-spacing: 2px; font-family: 'Merriweather', Georgia, serif;">Hush<span style="color: #ec4755;">Box</span></span>
            </td>
          </tr>
