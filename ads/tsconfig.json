{
  "extends": "../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": [
    "tools/**/*",
    "src/**/*",
    "*/spec.ts",
    "*/spec.test.ts",
    "*/03-screen-capture/*.ts",
    "*.config.js",
    "remotion.config.ts"
  ],
  "exclude": ["node_modules"]
}
