---
import { CrawlerEye as CrawlerEyeBadge } from '@hushbox/ui';

/**
 * Dev-only crawler-eye badge mount for the marketing (Astro/SSG) site — renders
 * the shared `@hushbox/ui` badge as an island.
 *
 * Gated on a BUILD-TIME constant: `import.meta.env.DEV` is a compile-time boolean
 * Astro strips on (the island is absent from production builds), and `!VITE_E2E`
 * excludes the E2E build — which is also dev-mode (`--mode development`) and would
 * otherwise bake the badge in, where its `/api/crawl` fetch trips the app CSP. So
 * the island (and its JS) is emitted only in a real `pnpm dev` build.
 *
 * Marketing has no runtime env utility by design; `env.isDevServer` (the web
 * side's gate) is a runtime value that can't be statically stripped, so the
 * SSG site uses the build-time-constant idiom instead.
 */
const gateOn = import.meta.env.DEV && !import.meta.env.VITE_E2E;

// env.config guarantees VITE_CRAWLER_VIEW_URL in Development — the only mode where
// gateOn is true; a missing value there is a config defect, so fail fast.
function crawlerViewOrigin(): string {
  const origin = import.meta.env.VITE_CRAWLER_VIEW_URL;
  if (origin === undefined) {
    throw new Error('VITE_CRAWLER_VIEW_URL must be defined when the dev server runs');
  }
  return origin;
}

const badgeOrigin = gateOn ? crawlerViewOrigin() : null;
---

{badgeOrigin !== null && <CrawlerEyeBadge client:load origin={badgeOrigin} />}
